# Database
DATABASE_URL="postgresql://username:password@localhost:5432/indian_ecommerce"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="your-jwt-secret"

# Email (AWS SES)
EMAIL_SERVER_HOST="email-smtp.ap-south-1.amazonaws.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-ses-user"
EMAIL_SERVER_PASSWORD="your-ses-password"
EMAIL_FROM="noreply@yourstore.com"

# SMS (MSG91)
MSG91_API_KEY="your-msg91-api-key"
MSG91_SENDER_ID="YOURSTORE"

# AWS S3
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET="your-s3-bucket"
CLOUDFRONT_DOMAIN="your-cloudfront-domain"

# Payment Gateways
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

PAYTM_MERCHANT_ID="your-paytm-merchant-id"
PAYTM_MERCHANT_KEY="your-paytm-merchant-key"

CCAVENUE_ACCESS_CODE="your-ccavenue-access-code"
CCAVENUE_WORKING_KEY="your-ccavenue-working-key"

# App URLs
WEB_BASE_URL="http://localhost:3000"
API_BASE_URL="http://localhost:3001"

# Feature Flags
ENABLE_PAYTM="false"
ENABLE_CCAVENUE="false"
ENABLE_WHATSAPP_COMMERCE="false"

# Analytics
GOOGLE_ANALYTICS_ID="GA-XXXXXXXXX"
SENTRY_DSN="your-sentry-dsn"

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE="100"
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE="5"